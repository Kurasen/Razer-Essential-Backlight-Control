/* Application resources for BWBacklight.exe.
 * app.ico is generated from razer.png (16/24/32/48 as 32bpp DIB,
 * 64/128/256 as PNG frames) and becomes icon group ID 1, which is the
 * icon Windows shows for the executable file itself. The GUI loads the
 * same ID (APP_ICON_ID in gui.c) for the window and taskbar icon.
 */

#include <windows.h>

#define IDI_APP_ICON 1
IDI_APP_ICON ICON "app.ico"
